{
  "components": {
    "schemas": {
      "ConfigMutation": {
        "description": "Revision CAS; stale revision returns conflict, possibly in terminal operation result after ACK. Refresh config.get and preserve user edits for explicit revalidation; never auto-overwrite. Restart-required returns a failed operation and preserves safe status for reload.",
        "properties": {
          "expected_revision": {
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "request_key": {
            "type": "string"
          },
          "values": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "values",
          "expected_revision"
        ],
        "type": "object"
      },
      "Conflict": {
        "description": "409: stale revision, busy controller, or reused request_key with changed actor/payload. HTTP error contains safe code/message only; refresh state and inspect operation status.",
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "conflict"
              },
              "message": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Operation": {
        "properties": {
          "actor": {
            "type": "string"
          },
          "created_unix_ms": {
            "type": "integer"
          },
          "expected_revision": {
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "request_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "description": "Safe outcome projection; status, outcome, revision, needs_recovery and error code as applicable.",
            "type": [
              "object",
              "null"
            ]
          },
          "stage": {
            "type": "string"
          },
          "state": {
            "enum": [
              "running",
              "completed",
              "failed",
              "interrupted"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "state",
          "stage",
          "method"
        ],
        "type": "object"
      },
      "OperationAck": {
        "description": "Acknowledgment of admission, not success. Poll operations.get with id. Same-key retry returns original operation; conflict requires refresh.",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "running",
              "completed",
              "failed",
              "interrupted"
            ]
          }
        },
        "required": [
          "id",
          "state"
        ],
        "type": "object"
      },
      "Session": {
        "properties": {
          "csrf_token": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "expires_in_secs": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "csrf_token",
          "expires_in_secs"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "twintail_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "All requests require exact Host and no query string. Mutations require exact Origin; GET with an Origin also requires exact match. Sessions use fixed TTL. All manage calls, including reads, require CSRF. No CORS. Request body/time/concurrency/connection/session limits apply.",
    "title": "TwinTail loopback web administrator",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/manage": {
      "post": {
        "description": "Read capability: management.overview, plugins.list/status/installed/inspect, operations.list/get, config.get/schema/validate, diagnostics.logs, adapter.status. Write capability: plugins.install/enable/disable/uninstall/reload/start/stop and config.update. Read-only grants receive 403 on writes. Targeted calls use payload.id; operations.get uses operation id. Config input uses unresolved values, never resolved secrets. Lifecycle/config mutations immediately return result OperationAck: poll operations.get until completed/failed/interrupted. A 504 or lost response does not prove mutation failure; use operations.list and the same request_key rather than blindly retrying. Results and payloads vary by method.",
        "parameters": [
          {
            "description": "Exact http://bound-loopback-IP:port; forwarded origins and localhost aliases rejected",
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "enum": [
                      "management.overview",
                      "plugins.list",
                      "plugins.status",
                      "plugins.installed",
                      "plugins.inspect",
                      "operations.list",
                      "operations.get",
                      "config.get",
                      "config.schema",
                      "config.validate",
                      "diagnostics.logs",
                      "adapter.status",
                      "plugins.install",
                      "plugins.enable",
                      "plugins.disable",
                      "plugins.uninstall",
                      "plugins.reload",
                      "plugins.start",
                      "plugins.stop",
                      "config.update"
                    ],
                    "maxLength": 128,
                    "type": "string"
                  },
                  "payload": {
                    "description": "Method-specific payload: id selects plugin/operation. Install uses path; enable uses id, optional version and grants. Mutations accept optional request_key (1..128 ASCII alphanumeric/dot/underscore/hyphen) for idempotency; same key with changed payload or actor conflicts. config.validate/update use values; update additionally requires expected_revision. plugin reload may select candidate version. See ConfigMutation and Operation schemas.",
                    "properties": {
                      "expected_revision": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "id": {
                        "type": "string"
                      },
                      "request_key": {
                        "pattern": "^[a-zA-Z0-9._-]{1,128}$",
                        "type": "string"
                      },
                      "values": {
                        "description": "Full unresolved configuration; retain {$secret: ENV_NAME} environment references. Browser rejects literal writeOnly credentials; migrate through local CLI.",
                        "type": "object"
                      }
                    },
                    "type": "object"
                  }
                },
                "required": [
                  "method",
                  "payload"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "result": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/OperationAck"
                        },
                        {
                          "description": "Read result, e.g. operation record, plugin snapshot/list, unresolved configuration/schema, diagnostic projection; distinguished by requested method. Read objects may also contain id/state, use requested method to interpret.",
                          "type": [
                            "object",
                            "array"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "result"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Host result; mutations acknowledge an operation and must be polled"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Safe error; never contains upstream message/details or credentials"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Safe error; never contains upstream message/details or credentials"
          },
